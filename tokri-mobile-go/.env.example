# Copy to .env for local Expo (staging by default):
#   cp .env.example .env
#
# Staging server = https://server.tokriii.com  → API /api/v1
EXPO_PUBLIC_API_BASE_URL=https://server.tokriii.com/api/v1

# Live (only if you want local Expo against production — usually avoid):
# EXPO_PUBLIC_API_BASE_URL=https://tokriii.com/api/v1
#
# EAS:
#   eas build --profile staging     → server.tokriii.com
#   eas build --profile production  → tokriii.com
# No need to edit config.js when promoting code live.
