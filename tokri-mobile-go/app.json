{
  "expo": {
    "name": "Tokriii",
    "slug": "tokriii",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#022c22"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tokriii.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tokriii uses your location to fill your delivery address."
      }
    },
    "updates": {
      "enabled": false
    },
    "android": {
      "package": "com.tokriii.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#022c22"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://tokriii.com/api/v1",
      "eas": {
        "projectId": "691345d1-b096-4f13-b978-0750f6e66762"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tokriii uses your location to fill your delivery address."
        }
      ]
    ]
  }
}
